{
  "name": "electoral-canvas",
  "version": "0.1.0",
  "description": "Electoral canvas methodology built with react-flexcanvas and puppeteer.",
  "main": "index.js",
  "scripts": {
    "start": "nodemon src/index.js --exec babel-node --presets es2015,stage-0",
    "test": "echo \"Error: no test specified\" && exit 1",
    "setup": "rm -rf public/* dist/*",
    "build": "npm run setup && cross-env NODE_ENV=production webpack --config webpack.config.js --mode=production && babel src -d dist --presets es2015,stage-0 --copy-files",
    "serve": "cross-env NODE_ENV=production node dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lianetoolkit/electoral-canvas.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/lianetoolkit/electoral-canvas/issues"
  },
  "homepage": "https://github.com/lianetoolkit/electoral-canvas#readme",
  "devDependencies": {
    "babel-cli": "^6.26.0",
    "babel-core": "^6.26.3",
    "babel-loader": "^7.1.4",
    "babel-plugin-syntax-class-properties": "^6.13.0",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "babel-plugin-transform-object-rest-spread": "^6.26.0",
    "babel-plugin-transform-runtime": "^6.23.0",
    "babel-preset-es2015": "^6.24.1",
    "babel-preset-react": "^6.24.1",
    "babel-preset-stage-0": "^6.24.1",
    "connect-history-api-fallback": "^1.5.0",
    "cross-env": "^5.1.5",
    "css-loader": "^7.1.2",
    "file-loader": "^1.1.11",
    "html-webpack-plugin": "^5.6.3",
    "less": "^3.0.4",
    "less-loader": "^4.1.0",
    "node-sass": "^9.0.0",
    "sass-loader": "^7.0.1",
    "style-loader": "^0.20.3",
    "webpack": "^4.8.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-middleware": "^5.3.4",
    "webpack-hot-middleware": "^2.22.1"
  },
  "dependencies": {
    "axios": "^0.30.0",
    "body-parser": "^1.20.3",
    "express": "^4.21.2",
    "font-awesome": "^4.7.0",
    "ioredis": "^3.2.2",
    "lodash": "^4.17.21",
    "nodemon": "^3.1.10",
    "puppeteer": "^22.8.2",
    "react": "^16.14.0",
    "react-dom": "^16.14.0",
    "react-flexcanvas": "^0.3.4",
    "react-markdown": "^10.1.0",
    "react-router": "^4.2.0",
    "react-router-dom": "^4.2.2",
    "remark-breaks": "^1.0.0",
    "skeleton-css": "^2.0.4",
    "underscore": "^1.13.7"
  },
  "nodemonConfig": {
    "ignore": [
      "files/*"
    ],
    "delay": "1000"
  }
}
